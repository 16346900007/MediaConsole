{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocialManager",
  "version": "2.3.0",
  "identifier": "com.socialmanager.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tauri\\dev-check.ps1",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tauri\\prepare.ps1",
    "frontendDist": "../dist/dist/client"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main", "social-auth"],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:webview:allow-create-webview-window",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../dist-tauri/node/node.exe", "../dist-tauri/backend.tar"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
