# Dependencies
node_modules/
*/node_modules/

# Tauri（Rust 构建产物：target 可达数百 MB，backend.tar/node.exe 均在其中）
src-tauri/target/
dist-tauri/
dist-exe/
build-tools/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files（本地环境配置，可能含数据库地址/密钥，一律不入库）
.env
.env.*
!.env.example
*.local

# Logs（含本地排障脚本/诊断输出）
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log
/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/
.playwright-cli/

# Lock files (keep package-lock.json for consistent installs)
yarn.lock
pnpm-lock.yaml

# Cache files
.eslintcache
*.tsbuildinfo
.vite/

# swc wasm
.swc

# Agent files
.agent/

# 本地调试脚本（含数据库连接串/cookie jar，禁止入库）
.dev/

# 本地调试脚本（日志提取/分析，禁止入库）
parse-fill-log.py
tail-fill-log.py
tail-kw.py
